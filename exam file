        function finishExam() {
            if (isExamFinished) return;
            isExamFinished = true;
            sessionStorage.setItem("exam_submitted", "true");

            clearInterval(overallInterval);

            document.getElementById('page-exam').classList.add('hidden');
            document.getElementById('page-result').classList.remove('hidden');
            
            generateResultView();
            autoDownloadPDF();
        }

        function generateResultView() {
            const container = document.getElementById('pdf-questions-list');
            container.innerHTML = '';

            let correctCount = 0;
            let wrongCount = 0;
            let unattemptedCount = 0;

            questionsData.forEach((q, idx) => {
                const block = document.createElement('div');
                block.className = 'pdf-q-block';
                let html = `<div><strong>Q.No: ${idx + 1}</strong> ${q.text}</div>`;
                
                if (q.image && q.image.trim() !== '') {
                    html += `<img src="${q.image}" style="max-width:300px; display:block; margin:8px 0;">`;
                }

                if (q.userAnswer === null) {
                    unattemptedCount++;
                } else if (q.userAnswer === q.correct) {
                    correctCount++;
                } else {
                    wrongCount++;
                }

                q.options.forEach((opt, oIdx) => {
                    let optClass = 'pdf-option-item pdf-normal-option';
                    
                    if (q.userAnswer === oIdx && q.userAnswer === q.correct) {
                        optClass = 'pdf-option-item pdf-selected-correct';
                    } else if (q.userAnswer === oIdx && q.userAnswer !== q.correct) {
                        optClass = 'pdf-option-item pdf-selected-wrong';
                    } else if (oIdx === q.correct) {
                        optClass = 'pdf-option-item pdf-unselected-correct';
                    }
                    
                    html += `<div class="${optClass}">${oIdx + 1}) ${opt}</div>`;
                });

                block.innerHTML = html;
                container.appendChild(block);
            });

            let totalMarks = (correctCount * 1.0) - (wrongCount * 0.33);
            document.getElementById('score-summary').innerHTML = `
                <div>Correct Answers: <span style="color:green;">${correctCount}</span> | Wrong Answers: <span style="color:red;">${wrongCount}</span> | Unattempted: ${unattemptedCount}</div>
                <div style="font-size:18px; margin-top:5px; color:#003366;">Final Score: ${totalMarks.toFixed(2)} / ${questionsData.length}</div>
            `;
        }

        function autoDownloadPDF() {
            const element = document.getElementById('pdf-container');
            html2canvas(element, { scale: 2, useCORS: true, allowTaint: true }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                
                const imgWidth = 210; 
                const pageHeight = 295; 
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft >= 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save('RRB_JE_CBT1_Result.pdf');

                setTimeout(() => {
                    history.replaceState(null, "", "about:blank");
                    window.location.href = "about:blank";
                }, 2000);
            });
        }
    </script>
