        function autoFullScreen() {
            if (isExamFinished) return;
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(() => {});
            }
        }

        document.addEventListener("fullscreenchange", () => {
            if (!document.fullscreenElement && !isExamFinished && !document.getElementById('page-exam').classList.contains('hidden')) {
                alert("Security Violation: Fullscreen Exited! Auto-submitting Exam.");
                finishExam();
            }
        });

        window.addEventListener("blur", () => {
            if (!isExamFinished && !document.getElementById('page-exam').classList.contains('hidden')) {
                alert("Security Violation: Window/Tab switch detected! Auto-submitting Exam.");
                finishExam();
            }
        });

        function toggleInlineKeypad() { 
            document.getElementById('inline-keypad').classList.toggle('hidden'); 
        }

        function pressKey(val) { 
            if (isKeypadDisabled) return;
            document.getElementById('input-pass').value += val; 
        }

        function clearPass() { 
            if (isKeypadDisabled) return;
            document.getElementById('input-pass').value = ''; 
        }

        function deleteKey() {
            if (isKeypadDisabled) return;
            let currentVal = document.getElementById('input-pass').value;
            document.getElementById('input-pass').value = currentVal.slice(0, -1);
        }

        function onLoginSuccess() {
            if (document.getElementById('input-pass').value === "") {
                document.getElementById('login-error').style.display = 'block';
                return;
            }

            isKeypadDisabled = true;
            const buttons = document.querySelectorAll('.vk-btn, .btn-login-ok');
            buttons.forEach(btn => btn.disabled = true);

            autoFullScreen();

            setTimeout(() => {
                document.getElementById('blurred-overlay').classList.remove('hidden');
            }, 120000);
        }

        function proceedToInstructions() {
            document.getElementById('blurred-overlay').classList.add('hidden');
            document.getElementById('page-login').classList.add('hidden');
            document.getElementById('page-instructions').classList.remove('hidden');
        }

        function handleDeclarationCheck() {
            const chk = document.getElementById('chk-declaration');
            const btn = document.getElementById('btn-start-exam');
            btn.disabled = !chk.checked;
        }

        function startExam() {
            autoFullScreen();
            document.getElementById('page-instructions').classList.add('hidden');
            document.getElementById('page-exam').classList.remove('hidden');
            startTimers();
            loadQuestion();
        }

        function startTimers() {
            overallInterval = setInterval(() => {
                overallTimeLeft--;
                let h = Math.floor(overallTimeLeft / 3600);
                let m = Math.floor((overallTimeLeft % 3600) / 60);
                let s = overallTimeLeft % 60;
                
                document.getElementById('timer-h').innerText = h < 10 ? '0' + h : h;
                document.getElementById('timer-m').innerText = m < 10 ? '0' + m : m;
                document.getElementById('timer-s').innerText = s < 10 ? '0' + s : s;
                
                if (overallTimeLeft <= 0) finishExam();
            }, 1000);
        }

        function loadQuestion() {
            if (questionsData.length === 0) return;
            
            const q = questionsData[currentQuestionIndex];
            if (q.status === 'not-visited') q.status = 'not-answered';

            document.getElementById('display-q-num').innerText = `Question No. ${currentQuestionIndex + 1}`;
            document.getElementById('q-text').innerText = q.text;

            const imgContainer = document.getElementById('q-image-container');
            imgContainer.innerHTML = '';
            if (q.image && q.image.trim() !== '') {
                const img = document.createElement('img');
                img.src = q.image;
                img.className = 'q-img-style';
                imgContainer.appendChild(img);
            }

            const container = document.getElementById('options-container');
            container.innerHTML = '';
            q.options.forEach((opt, idx) => {
                const label = document.createElement('label');
                label.className = 'opt-label-style';
                const checked = q.userAnswer === idx ? 'checked' : '';
                label.innerHTML = `<input type="radio" name="opt" value="${idx}" ${checked} onclick="selectOption(${idx})"> <span>${String.fromCharCode(65 + idx)}. ${opt}</span>`;
                container.appendChild(label);
            });

            renderPalette();
        }

        function selectOption(idx) { questionsData[currentQuestionIndex].userAnswer = idx; }

        function saveAndNext() {
            const q = questionsData[currentQuestionIndex];
            q.status = q.userAnswer !== null ? 'answered' : 'not-answered';
            navigateQuestion(1);
        }

        function clearResponse() {
            const q = questionsData[currentQuestionIndex];
            q.userAnswer = null;
            q.status = 'not-answered';
            loadQuestion();
        }

        function markForReview() {
            const q = questionsData[currentQuestionIndex];
            q.status = q.userAnswer !== null ? 'ans-review' : 'review';
            navigateQuestion(1);
        }

        function navigateQuestion(dir) {
            if (dir === 1 && currentQuestionIndex < questionsData.length - 1) {
                currentQuestionIndex++;
                loadQuestion();
            } else if (dir === -1 && currentQuestionIndex > 0) {
                currentQuestionIndex--;
                loadQuestion();
            } else {
                renderPalette();
            }
        }

        function renderPalette() {
            const grid = document.getElementById('palette-grid');
            grid.innerHTML = '';

            let counts = { ans: 0, ansRev: 0, notAns: 0, rev: 0, notVis: 0 };

            questionsData.forEach((q, i) => {
                const btn = document.createElement('button');
                btn.className = 'qp-btn';
                btn.innerText = i + 1;

                if (q.status === 'answered') { 
                    btn.style.background = 'linear-gradient(180deg, #4caf50 0%, #2e7d32 100%)'; 
                    btn.style.color = '#fff'; 
                    btn.style.boxShadow = '0 3px 0 #1b5e20';
                    counts.ans++; 
                }
                else if (q.status === 'not-answered') { 
                    btn.style.background = 'linear-gradient(180deg, #ef5350 0%, #d32f2f 100%)'; 
                    btn.style.color = '#fff'; 
                    btn.style.boxShadow = '0 3px 0 #b71c1c';
                    counts.notAns++; 
                }
                else if (q.status === 'review') { 
                    btn.style.background = 'linear-gradient(180deg, #ab47bc 0%, #7b1fa2 100%)'; 
                    btn.style.color = '#fff'; 
                    btn.style.boxShadow = '0 3px 0 #4a148c';
                    counts.rev++; 
                }
                else if (q.status === 'ans-review') { 
                    btn.style.background = 'linear-gradient(180deg, #ab47bc 0%, #7b1fa2 100%)'; 
                    btn.style.color = '#fff'; 
                    btn.style.boxShadow = '0 3px 0 #4a148c';
                    counts.ansRev++; 
                }
                else { 
                    btn.style.background = 'linear-gradient(180deg, #ffffff 0%, #e0e0e0 100%)'; 
                    btn.style.color = '#000'; 
                    counts.notVis++; 
                }

                btn.onclick = () => { currentQuestionIndex = i; loadQuestion(); };
                grid.appendChild(btn);
            });

            document.getElementById('count-ans').innerText = counts.ans;
            document.getElementById('count-ans-rev').innerText = counts.ansRev;
            document.getElementById('count-not-ans').innerText = counts.notAns;
            document.getElementById('count-rev').innerText = counts.rev;
            document.getElementById('count-not-vis').innerText = counts.notVis;
        }

